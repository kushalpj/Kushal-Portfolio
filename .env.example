# EmailJS configuration for the contact form (https://www.emailjs.com).
# Copy this file to .env and fill in the values. Restart `npm run dev` afterwards.
# If these are empty the form validates input but will NOT claim a message was sent;
# it offers a "open in your email app" fallback instead.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
